# Ignore everything by default except project files
/*

# Tracked GAS & Repo files
!.gitignore
!.claspignore
!.clasp.json
!.clasp.prod.json
!.agents/
!.agents/**
!deploy-staging.bat
!deploy-prod.bat
!README.md
!appsscript.json
!Code.js
!driveSync.js
!Index.html

# Never track secrets or environment files
.env
.env.*
!.env.example
.clasprc.json
node_modules/
